# ─────────────────────────────────────────────────────────────────────────────
# AI-Powered Multi-Agent Security Audit System — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini API ────────────────────────────────────────────────────────────────
# Required. Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# ── GitHub (Optional) ─────────────────────────────────────────────────────────
# Optional. Provide a GitHub personal access token to:
# - Avoid rate limiting on the GitHub API
# - Scan private repositories you have access to
# Token needs read:repo scope for private repos.
GITHUB_TOKEN=

# ── OWASP ZAP (Optional) ──────────────────────────────────────────────────────
# Optional. Only needed if OWASP ZAP daemon is running locally.
ZAP_API_KEY=
ZAP_HOST=localhost
ZAP_PORT=8080

# ── Application Settings ──────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory to store generated reports
REPORTS_DIR=reports

# Maximum repository size to clone (in MB; default: 200)
MAX_REPO_SIZE_MB=200

# FastAPI backend URL (used by Streamlit)
API_BASE_URL=http://localhost:8000
